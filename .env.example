# Supabase — obter em https://supabase.com/dashboard/project/SEU_PROJETO/settings/api
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua_anon_key
# ATENÇÃO: a service_role key NUNCA deve ter um nome VITE_* nem ser lida em
# src/ — qualquer env VITE_* referenciada no código é embutida em texto claro
# no bundle JS público. Operações privilegiadas vivem só em Supabase Edge
# Functions (supabase/functions/sso-exchange, .../admin-user-management), que
# recebem SUPABASE_SERVICE_ROLE_KEY automaticamente do runtime do Supabase —
# não precisa (e não deve) configurar isso no .env do frontend.
# Só o migrate.mjs (script Node, fora do bundle) usa uma service role key,
# passada na hora da execução via SUPABASE_SERVICE_ROLE_KEY (sem prefixo VITE_).

# Rastro de acesso cross-sistema — timeline central no vpsistema (portal).
# Valor combinado fora do código; peça ao administrador do vpsistema.
VITE_TRACK_ACTIVITY_KEY=

# Credenciais do admin usadas SÓ pelo migrate.mjs, passadas na linha de comando
# no momento da execução. Não preencha aqui: senha não deve ficar em arquivo.
#   VP_ADMIN_EMAIL=
#   VP_ADMIN_PASSWORD=
#   VP_ADMIN_NAME=    (opcional; padrão é a parte antes do @ do email)
