# Supabase — obter em https://supabase.com/dashboard/project/SEU_PROJETO/settings/api
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua_anon_key
# ATENÇÃO: SERVICE_ROLE_KEY nunca deve ir ao frontend em produção
# Use apenas em scripts server-side ou migrate.mjs
VITE_SUPABASE_SERVICE_ROLE_KEY=eyJ...sua_service_role_key

# Rastro de acesso cross-sistema — timeline central no vpsistema (portal).
# Valor combinado fora do código; peça ao administrador do vpsistema.
VITE_TRACK_ACTIVITY_KEY=

# Credenciais do admin usadas SÓ pelo migrate.mjs, passadas na linha de comando
# no momento da execução. Não preencha aqui: senha não deve ficar em arquivo.
#   VP_ADMIN_EMAIL=
#   VP_ADMIN_PASSWORD=
#   VP_ADMIN_NAME=    (opcional; padrão é a parte antes do @ do email)
