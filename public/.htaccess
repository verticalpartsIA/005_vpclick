# O index.html nunca pode ficar em cache: é ele que aponta para o bundle JS/CSS
# do build atual (nomes com hash, ex.: index-97_h4-MQ.css). Se o navegador guarda
# uma cópia antiga do index.html, ele carrega um bundle antigo indefinidamente —
# mesmo que esse bundle já tenha bugs corrigidos em builds mais novos — e só um
# hard refresh (que nem sempre limpa o cache) resolve. Os arquivos com hash em
# /assets podem ficar em cache pra sempre: o nome muda sempre que o conteúdo muda.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback de SPA: qualquer caminho sem arquivo/pasta correspondente serve o
# index.html (a própria aplicação decide o que renderizar client-side).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
