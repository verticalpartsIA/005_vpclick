# VP Click — cabeçalhos de cache para o build estático servido pela Hostinger
# (CDN "hcdn" na frente da origem, com múltiplos nós de borda).
#
# Sem isto, nada dizia à CDN como cachear cada arquivo: o `index.html` ficava
# sujeito à heurística própria dela, e nós de borda diferentes podiam guardar
# cópias de tempos diferentes — depois de um deploy, algumas requisições
# pegavam o `index.html` novo (referenciando o bundle JS novo) e outras uma
# cópia velha ainda apontando pro bundle antigo, causando comportamento
# inconsistente entre abas/tentativas (ver issue #40).
#
# Regra: o `index.html` nunca é servido do cache sem antes revalidar com a
# origem (usa o ETag/Last-Modified que o servidor já envia — na prática vira
# um 304 quase sempre, então não pesa). Os arquivos dentro de /assets/ têm
# hash no nome (gerado pelo Vite a cada build), então podem ficar em cache
# "para sempre": um deploy novo gera nomes novos, nunca reaproveita um antigo.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|mp4|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cabeçalhos de segurança básicos (auditoria Lighthouse). CSP fica de fora
  # por ora: exige mapear com cuidado toda origem externa usada pelo app
  # (Supabase, avatares, fontes, etc.) e um jeito de validar em produção antes
  # de publicar — errar a CSP quebra o app inteiro sem aviso. Sem risco disso
  # aqui: nenhum dos headers abaixo depende de allowlist de origem, e o app
  # não usa iframe/window.opener (entrada é sempre por redirect do SSO, não
  # embed), então SAMEORIGIN/COOP não interferem no login.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Reforço específico pro LiteSpeed Cache (LSCache) da Hostinger: o
# Cache Manager do hPanel roda nessa camada, separada do Apache puro, e pode
# cachear o index.html por conta própria mesmo com o Cache-Control acima.
# X-LiteSpeed-Cache-Control é o jeito documentado do LSCache respeitar
# "não cachear esta resposta" por arquivo. Fica sem efeito (inofensivo) se o
# módulo não estiver ativo.
<IfModule LiteSpeed>
  <FilesMatch "^index\.html$">
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# SPA: qualquer rota sem arquivo físico correspondente cai no index.html
# (o roteamento de tela é feito em JS, não por múltiplos arquivos HTML).
#
# /assets/ fica FORA desse fallback de propósito. Lá dentro só existe arquivo
# gerado pelo Vite com hash no nome — nunca uma rota de tela. Quando o fallback
# pegava /assets/ também, um bundle inexistente respondia "200 text/html" com o
# conteúdo do index.html em vez de 404, e isso quebrava de dois jeitos:
#
#   1. Navegador com index.html velho em cache pede o bundle antigo, recebe
#      HTML disfarçado de JS e o script morre sem erro claro — a tela abre mas
#      o app nunca monta (sintoma investigado nas issues #38/#40/#41).
#   2. A verificação de deploy (.github/workflows/deploy.yml) conferia só o
#      código HTTP, então qualquer asset faltando passava como 200/OK. A rede
#      de proteção criada justamente pro caso "index.html subiu mas o JS não"
#      nunca conseguiria disparar.
#
# Sem o fallback, asset ausente vira 404 de verdade: o navegador reporta o erro
# e a verificação de deploy consegue enxergar a falha.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
